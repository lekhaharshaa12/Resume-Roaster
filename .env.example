# ── Anthropic Claude API (Paid Credits Required) ───────────────
# Get a key at: https://console.anthropic.com/
# Add credits at: https://console.anthropic.com/settings/billing
ANTHROPIC_API_KEY=your-anthropic-key-here

# ── Local MySQL Database ───────────────────────────────────────
# Format: mysql://[username]:[password]@[host]:[port]/[database]
# For local use: mysql://root:password@localhost:3306/resumeroaster
# For public use (Ngrok): mysql://root:password@0.tcp.ngrok.io:[PORT]/resumeroaster
DATABASE_URL="mysql://root:password@localhost:3306/resumeroaster"
