# For local use: postgresql://postgres:password@localhost:5432/resumeroaster
# For Supabase pooler: postgresql://postgres.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres:password@localhost:5432/resumeroaster"
